#!/bin/sh
# Keep ordinary commits fast; CI runs the complete validation suite.
set -e

cargo fmt --check

# Opt into the previous full hook when useful (e.g. before publishing a branch).
if [ "${RUSTY_MONEY_FULL_CHECKS:-0}" = "1" ]; then
    cargo clippy --all-features --all-targets -- -D warnings
    PROPTEST_CASES=1000 cargo test --all-features
fi
